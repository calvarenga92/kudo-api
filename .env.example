# Copie para .env. Em dev, `npm run dev` já sobe um Postgres local e preenche DATABASE_URL.
DATABASE_URL=postgres://kudo:kudo@localhost:5432/kudo
PORT=3000
# Origens do front liberadas no CORS, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173
# Segredo que assina os tokens de sessão (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=
# Duração da sessão, em segundos (padrão: 1 hora).
SESSAO_DURACAO_SEGUNDOS=3600
